# Stage 1: Build the application
FROM node:20-alpine AS build
WORKDIR /app

# Copy configuration files and dependencies
COPY frontend-angular/package*.json ./
RUN npm ci

# Copy the source code and build the project
COPY frontend-angular/ .
RUN npm run build -- --configuration=production

# Stage 2: Serve the application using Nginx
FROM nginx:alpine

# Copy the built files to Nginx public folder
COPY --from=build /app/dist/gestion-clinique-frontend/browser /usr/share/nginx/html

# Rename index.csr.html to index.html (Angular 17+ SSR fallback)
RUN mv /usr/share/nginx/html/index.csr.html /usr/share/nginx/html/index.html || true

# Copy custom Nginx configuration
COPY frontend_nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
